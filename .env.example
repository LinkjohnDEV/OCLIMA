# ==========================================
# OCLIMA - SISTEMA DE PREVISÃO METEOROLÓGICA
# ==========================================

# 1º PROVEDOR (Principal): WeatherAPI.com (1.000.000 requisições/mês gratuitas)
VITE_WEATHERAPI_KEY=your_weatherapi_key_here
VITE_WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# 2º PROVEDOR (Failover 1): OpenWeatherMap
VITE_OPENWEATHER_API_KEY=your_openweather_key_here
VITE_API_BASE_URL=https://api.openweathermap.org/data/2.5
VITE_API_GEO_URL=https://api.openweathermap.org/geo/1.0
VITE_API_UNITS=metric

# 3º PROVEDOR (Failover 2): Open-Meteo & Intelligent Mock (Ativo por padrão em caso de falha)
